# Токен саппорт-бота (BotFather). Этот же токен НЕ должен быть в SUPPORT_BOT_TOKEN SOLObot — иначе 409.
BOT_TOKEN=

# Супергруппа операторов с включёнными Topics. Бот — админ с правом «Управление темами».
FORUM_CHAT_ID=-100...

# Чтение данных клиента из SOLObot (read-only роль). Имя базы SOLObot указывается в конце DSN. Пусто — карточка только с данными Telegram.
SOLO_DSN=postgresql://support_ro:password@127.0.0.1:5432/<имя_базы_solobot>

# Номер, с которого продолжается нумерация тикетов (старый бот закончил на T000050).
TICKET_START=50

# Тикет, где ответил оператор и клиент молчит N часов, закрывается автоматически. 0 — выключено.
AUTO_CLOSE_HOURS=48
# Автозакрытый (по молчанию клиента) тикет переоткрывается, если клиент написал в течение N часов. После ручного закрытия - новый тикет.
REOPEN_HOURS=72

# Антиспам: не больше SPAM_LIMIT сообщений за SPAM_WINDOW секунд.
SPAM_LIMIT=8
SPAM_WINDOW=60

ASK_RATING=true
DB_PATH=data/support.db
